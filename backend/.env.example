# ==========================================
# ChargeNav Backend Environment Configuration
# ==========================================

# Server Port (default: 5000)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/chargenav
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chargenav?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/chargenav

# JSON Web Token Secret & Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend CORS Origin URL
FRONTEND_ORIGIN=http://localhost:5173

# Python Recommendation Engine Settings
# Python executable path (e.g. 'python', 'python3', or full path to python.exe)
PYTHON_PATH=python

# Path to the charging stations Excel dataset
EXCEL_DATASET_PATH=../recom_model/charging_stations.xlsx
